{
	admin off
	auto_https disable_redirects
}

# Plain HTTP serves nothing but liveness: the API sets a Secure cookie.
:80 {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		redir https://{host}{uri} 308
	}
}

{$HERDER_HOSTNAME:localhost} {
	tls internal
	# Framing is limited to this origin rather than refused, because the
	# console embeds the API's own docs page. No HSTS: with Caddy's own
	# CA the browser has to be allowed to accept the certificate.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Content-Security-Policy "frame-ancestors 'self'"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	handle /healthz {
		respond "ok" 200
	}
	handle /api/v1/* {
		reverse_proxy herderapi:8000
	}
	@apidocs path /api/openapi.json /api/openapi.yaml /api/docs /api/redoc
	handle @apidocs {
		reverse_proxy herderapi:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}

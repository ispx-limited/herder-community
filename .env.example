# Release to run. Community images publish with each Herder release.
HERDER_VERSION=v0.9.0

# The address CPEs use to reach the ACS: this host's LAN IP or DNS
# name. CPEs are pointed at http://ACS_HOST:CWMP_PORT/ (TR-069) or
# mqtt://ACS_HOST:MQTT_PORT (TR-369).
ACS_HOST=192.0.2.10

# The hostname the console serves on. Caddy issues an internal
# certificate for it; the browser will warn once.
HERDER_HOSTNAME=localhost

# Usage reporting: one aggregate report a day to ispx (fleet counts by
# vendor, model and firmware, load, feature use; never a serial number
# or an address). The licence page shows every report. Set to off to
# stop it. https://docs.herder.ispx.co/guides/usage-reporting/
USAGE_REPORTING=on

# Published ports.
HTTP_PORT=80
HTTPS_PORT=443
CWMP_PORT=7547
FIRMWARE_PORT=7549
MQTT_PORT=1883
# Diagnostics, bound to loopback only.
HEALTH_PORT=19090
NATS_MONITOR_PORT=8222

# Secrets. Left empty, ./up.sh fills them with generated values on
# first run. Set them yourself to override; the NATS_* values must
# start with a letter (NATS parses substituted values as config
# tokens, and a leading digit is a parse error).
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
NATS_SYS_PASSWORD=
NATS_HERDER_PASSWORD=
NATS_DEVICES_PASSWORD=
NATS_AUTHSERVICE_PASSWORD=
USP_MQTT_DEVICE_SECRET=
FIRMWARE_SIGNING_KEY=
CWMP_FACTORY_PASSWORD=
